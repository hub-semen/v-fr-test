{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/betting/**",
              "components/brand/**",
              "components/core/**",
              "components/feedback/**",
              "ui_kits/banners/**",
              "ui_kits/email/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Plus Jakarta Sans|Archivo|Archivo Black|Chakra Petch))/i]",
        "message": "Font not provided by the design system. Available: Plus Jakarta Sans, Archivo, Archivo Black, Chakra Petch."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|name|size|ring|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, name, size, ring."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='ring'] > Literal[value!=/^(?:sport|red|neon|gold)$/]",
        "message": "<Avatar> ring must be one of 'sport' | 'red' | 'neon' | 'gold'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|solid|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, solid."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:red|pink|neon|gold|sport|dark)$/]",
        "message": "<Badge> tone must be one of 'red' | 'pink' | 'neon' | 'gold' | 'sport' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BonusCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:vertical|kicker|amount|headline|cta|onCta|key|ref|className|style|children)$/]",
        "message": "<BonusCard> doesn't accept that prop. Declared props: vertical, kicker, amount, headline, cta, onCta."
      },
      {
        "selector": "JSXOpeningElement[name.name='BonusCard'] > JSXAttribute[name.name='vertical'] > Literal[value!=/^(?:sports|casino|esports|crypto|red)$/]",
        "message": "<BonusCard> vertical must be one of 'sports' | 'casino' | 'esports' | 'crypto' | 'red'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|block|uppercase|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, block, uppercase."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|pink|neon|gold|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'pink' | 'neon' | 'gold' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|height|tagline|title|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: tone, height, tagline, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<Logo> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Competitor'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|flag|key|ref|className|style|children)$/]",
        "message": "<Competitor> doesn't accept that prop. Declared props: name, flag."
      },
      {
        "selector": "JSXOpeningElement[name.name='OddsChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:price|label|selected|tone|key|ref|className|style|children)$/]",
        "message": "<OddsChip> doesn't accept that prop. Declared props: price, label, selected, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='OddsChip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<OddsChip> tone must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PromoCode'] > JSXAttribute > JSXIdentifier[name!=/^(?:code|label|onCopy|key|ref|className|style|children)$/]",
        "message": "<PromoCode> doesn't accept that prop. Declared props: code, label, onCopy."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|align|tone|accent|size|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: eyebrow, align, tone, accent, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<SectionHeading> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<SectionHeading> tone must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:h1|h2|h3)$/]",
        "message": "<SectionHeading> size must be one of 'h1' | 'h2' | 'h3'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SocialBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:platforms|tone|size|key|ref|className|style|children)$/]",
        "message": "<SocialBar> doesn't accept that prop. Declared props: platforms, tone, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='SocialBar'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<SocialBar> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:vertical|label|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: vertical, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='vertical'] > Literal[value!=/^(?:sports|casino|esports|crypto)$/]",
        "message": "<Tag> vertical must be one of 'sports' | 'casino' | 'esports' | 'crypto'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
